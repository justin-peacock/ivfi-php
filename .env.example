# Environment for the single-container image (Dockerfile at the repository root).
# Paste into Coolify's environment variables (Developer view accepts this format).
# See docker/image/README.md for what each variable does.
#
# Mark every variable here runtime-only: none of them are needed at build time,
# and a build-time variable is passed to `docker build` as a build argument.

# Sign-in. Setting both a username and a password enables authentication and
# uploads; leave them unset for a public, read-only index.
IVFI_USERNAME=
# Prefer the hash so the plaintext never sits in the container's environment.
# Generate it with:
#   php -r 'echo password_hash(rtrim(fgets(STDIN)), PASSWORD_DEFAULT), PHP_EOL;'
# The hash contains `$`, so mark the variable literal in Coolify or it is mangled.
IVFI_PASSWORD_HASH=
# Or a plaintext password, hashed at container start. Ignored when a hash is set.
# IVFI_PASSWORD=

# Regex; authenticate only matching paths. Unset protects the whole index.
# IVFI_AUTH_RESTRICT=

# Uploads (only for signed-in users)
# IVFI_UPLOAD=true
# IVFI_UPLOAD_EXTENSIONS=jpg,png,mp4
# IVFI_UPLOAD_OVERWRITE=false
# IVFI_UPLOAD_DIRECTORIES=true
# IVFI_UPLOAD_RESTRICT=

# Largest accepted file. Cloudflare's proxy caps request bodies at 100 MB on
# most plans, and the request body limit sits 1 MB above this value.
IVFI_MAX_UPLOAD_SIZE=99M

# Proxy. Behind a Cloudflare tunnel the defaults are right. Without Cloudflare,
# set the header to X-Forwarded-For.
# IVFI_BEHIND_PROXY=true
# IVFI_CLIENT_IP_HEADER=CF-Connecting-IP
