{
    "compileOnSave": true,
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "node",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        // Browser code, so only the ambient types it actually uses. Without
        // this every installed @types/* is pulled in, including @types/node,
        // whose newer releases use syntax this TypeScript cannot parse.
        "types": ["modernizr"],
        // Enabled because they already pass. strictNullChecks is the only
        // remaining strict-family flag, staged work tracked in
        // docs/building.md: it's 774 errors on TypeScript 5.9.
        "strictBindCallApply": true,
        "noImplicitReturns": true,
        "strictFunctionTypes": true,
        "noImplicitThis": true,
        "noImplicitAny": true,
        "sourceMap": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src/core/**/*"],
    "ts-node": {
        "esm": true
    }
}
